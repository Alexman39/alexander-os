// Alexander OS — database schema (Stage 1).
// Rules (docs/DATABASE.md): UUID ids, created/updated timestamps, explicit
// user ownership on every personal record, migrations reviewed before apply.
// UUID defaults use `gen_random_uuid()` (not `pg_catalog.…`) because that is
// how Postgres stores it; the other spelling causes permanent migration drift.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity — tables required by Better Auth (generated by its CLI; keep in
// sync with `npx auth generate`). Only the owner's GitHub account may sign in.
// ---------------------------------------------------------------------------

model User {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  preference    UserPreference?
  projects      Project[]
  tasks         Task[]
  notes         Note[]
  tags          Tag[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Preferences
// ---------------------------------------------------------------------------

model UserPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// IANA timezone used for "today", schedules and briefings.
  timezone  String   @default("Europe/Athens")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preference")
}

// ---------------------------------------------------------------------------
// Organization — projects, tasks, notes, tags
// ---------------------------------------------------------------------------

/// Life area a project or task belongs to. Work and University have screens
/// in Stage 1; Life and Health are reserved.
enum Area {
  WORK
  UNIVERSITY
  LIFE
  HEALTH
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

/// INBOX = captured, not yet triaged. The project's "next action" is its
/// first open task by `position`, so it is derived, never duplicated.
enum TaskStatus {
  INBOX
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum NoteKind {
  NOTE
  IDEA
}

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  area        Area
  status      ProjectStatus @default(ACTIVE)
  dueDate     DateTime?     @db.Date
  tasks       Task[]
  notes       Note[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, area, status])
  @@map("project")
}

model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?    @db.Uuid
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  notes       String?
  /// Set directly for loose tasks; tasks in a project inherit its area in the UI.
  area        Area?
  status      TaskStatus @default(INBOX)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?  @db.Date
  /// Manual ordering within a list; lowest open task = project's next action.
  position    Int        @default(0)
  completedAt DateTime?
  tags        TaskTag[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([projectId, position])
  @@map("task")
}

model Note {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?   @db.Uuid
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kind      NoteKind  @default(NOTE)
  title     String
  body      String    @default("")
  pinned    Boolean   @default(false)
  tags      NoteTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
  @@map("note")
}

model Tag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lower-case, trimmed; unique per user.
  name      String
  tasks     TaskTag[]
  notes     NoteTag[]
  createdAt DateTime  @default(now())

  @@unique([userId, name])
  @@map("tag")
}

model TaskTag {
  taskId String @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tag")
}

model NoteTag {
  noteId String @db.Uuid
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tag")
}
