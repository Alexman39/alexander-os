# Alexander OS — environment variables
# Copy to .env.local for local development (never commit .env.local).
# Production values live in Vercel → Project → Settings → Environment Variables.
# See docs/SETUP.md for where each value comes from.

# --- Database (Neon via Vercel; filled in automatically by `vercel env pull`) ---
DATABASE_URL=
# Direct (non-pooled) connection, used by Prisma migrations
DATABASE_URL_UNPOOLED=

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally; your Vercel production URL in production
BETTER_AUTH_URL=http://localhost:3000
# From the GitHub OAuth app (use the "dev" app locally, the "prod" app on Vercel)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only this GitHub account may sign in (numeric ID, not username)
OWNER_GITHUB_ID=89802016

# --- AI (Gemini API free tier) ---
# From https://aistudio.google.com → Get API key. Public RSS excerpts only — never private records.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Scheduled jobs (GitHub Actions → protected job endpoints) ---
# Generate with: openssl rand -base64 32. Same value in Vercel and in GitHub Actions secrets.
CRON_SECRET=
